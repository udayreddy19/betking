# =============================================================================
# ODDSYRA SPORTSBOOK — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO VERSION CONTROL
# =============================================================================

# =============================================================================
# 1. REQUIRED CORE RUNTIME VARIABLES
# =============================================================================

# Node Environment: Must be strictly 'production'
NODE_ENV=production

# Backend Server Listening Port (Default: 5001)
PORT=5001

# Authoritative Application & API Public Base URLs
APP_NAME=OddsYra Sportsbook
APP_URL=https://YOUR_DOMAIN
FRONTEND_URL=https://YOUR_DOMAIN
API_URL=https://YOUR_DOMAIN

# PostgreSQL Primary Database Connection URI (with credentials)
# Example: postgresql://oddsyra_app:STRONG_PASSWORD@postgres:5432/oddsyra?sslmode=prefer&pool_max=20
DATABASE_URL=postgresql://oddsyra_app:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/oddsyra

# Redis Primary Cache & Rate Limit Broker URI
# Example: redis://:STRONG_REDIS_PASSWORD@redis:6379
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# JSON Web Token Secret Key (MUST be at least 32 cryptographically random characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET_32_CHARACTERS_MINIMUM

# Cross-Origin Resource Sharing (CORS) Whitelist (Comma-separated, NO wildcards with credentials)
CORS_ORIGIN=https://YOUR_DOMAIN
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

# Security Enforcement: Disable development admin bypasses
ADMIN_DEV_LOGIN=0
DEMO_MODE=0
E2E_HARNESS=0

# =============================================================================
# 2. PAYMENT PROVIDERS (Configured per enabled gateway)
# =============================================================================

# ── RAZORPAY GATEWAY ──
# Required if Razorpay is enabled in admin payment settings
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_PRODUCTION_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION_RAZORPAY_WEBHOOK_SECRET

# ── CASHFREE GATEWAY ──
# Required if Cashfree is enabled in admin payment settings
CASHFREE_APP_ID=CHANGE_ME_PRODUCTION_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=CHANGE_ME_PRODUCTION_CASHFREE_SECRET_KEY
CASHFREE_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION_CASHFREE_WEBHOOK_SECRET

# =============================================================================
# 3. OPTIONAL RUNTIME & PERFORMANCE SETTINGS
# =============================================================================

# Dedicated Read Replica Connection Pool (Optional; falls back to DATABASE_URL)
DATABASE_READ_URL=

# Rate Limiting Parameters (Default: 5 login attempts / 60 seconds)
AUTH_LOGIN_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW=60

# Background Worker & Scheduler Control
# Set to 'false' on web API nodes and 'true' on dedicated background worker containers
RUN_BACKGROUND_WORKERS=true
WORKER_PROCESS=1

# =============================================================================
# 4. EMAIL — OddsYra mailboxes (add Zoho / Resend passwords; never commit secrets)
#   no-reply@oddsyra.com  → transactional / security (send)
#   promos@oddsyra.com    → marketing / targeted campaigns (send)
#   support@oddsyra.com   → player support inbox + Reply-To (receive)
#   alerts@oddsyra.com    → ops / SLA / new-ticket alerts (receive)
# =============================================================================

SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@oddsyra.com
SMTP_PASSWORD=
SMTP_FROM="OddsYra <no-reply@oddsyra.com>"
SMTP_PRIMARY_DAILY_LIMIT=0

SMTP_PROMOS_HOST=smtp.zoho.in
SMTP_PROMOS_PORT=465
SMTP_PROMOS_SECURE=true
SMTP_PROMOS_USER=promos@oddsyra.com
SMTP_PROMOS_PASSWORD=
PROMOS_FROM="OddsYra Promotions <promos@oddsyra.com>"
PROMOS_REPLY_TO=promos@oddsyra.com

SUPPORT_FROM="OddsYra Support <support@oddsyra.com>"
SUPPORT_REPLY_TO=support@oddsyra.com
SUPPORT_INBOX_EMAIL=support@oddsyra.com
ALERTS_FROM="OddsYra Alerts <alerts@oddsyra.com>"
SUPPORT_ALERT_EMAIL=alerts@oddsyra.com
PAYMENTS_ALERT_EMAIL=payments@oddsyra.com
PAYMENTS_DEPOSIT_HIGH_INR=10000
PAYMENTS_ESCALATE_CC=alerts@oddsyra.com
PAYMENTS_DEPOSIT_DIGEST_BELOW_INR=500
PAYMENTS_DEPOSIT_DIGEST_INTERVAL_MS=3600000

# Optional Brevo fallback
# SMTP_FALLBACK_HOST=smtp-relay.brevo.com
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_SECURE=false
# SMTP_FALLBACK_USER=
# SMTP_FALLBACK_PASSWORD=

# =============================================================================
# 5. MONITORING & TELEMETRY
# =============================================================================

# Bearer Token to protect /metrics Prometheus scraper endpoint
METRICS_TOKEN=CHANGE_ME_PRODUCTION_METRICS_BEARER_TOKEN

# Log Level: 'info', 'warn', 'error'
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true

# =============================================================================
# 6. FRONTEND BUILD VARIABLES (Passed into Vite bundle at build time)
# =============================================================================

# Canonical Site URL for SEO, OpenGraph, and JSON-LD schemas
VITE_SITE_URL=https://YOUR_DOMAIN

# Razorpay Public Key ID for browser modal checkout (Public safe)
VITE_RAZORPAY_KEY_ID=rzp_live_CHANGE_ME_RAZORPAY_KEY_ID

# Admin navigation eligibility hint (Comma-separated admin emails; client UX only)
VITE_ADMIN_EMAILS=admin@YOUR_DOMAIN

# Inactivity auto-logout timeout in milliseconds (Default: 30 minutes)
VITE_SESSION_IDLE_LOGOUT_MS=1800000
