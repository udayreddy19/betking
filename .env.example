# BetKing Local Environment Configuration
NODE_ENV=development
PORT=5001

# PostgreSQL Configuration
POSTGRES_DB=betking
POSTGRES_USER=betking_app
POSTGRES_PASSWORD=betking_dev_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgresql://betking_app:betking_dev_pass@127.0.0.1:5432/betking

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Auth & Security
JWT_SECRET=betking_jwt_secret_dev_key_2026
CORS_ORIGIN=http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=betking_wh_secret_2026
VITE_RAZORPAY_KEY_ID=rzp_test_your_key

# Frontend demo wallet (local dev without real payments)
VITE_DEMO_MODE=1

# SMTP Email Delivery
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@betking.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM="BetKing Support <no-reply@betking.com>"

# Application URLs
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Admin bootstrap (never enable in production)
ADMIN_DEV_LOGIN=0
