# OddsYra Local Environment Configuration
NODE_ENV=development
PORT=5001

# PostgreSQL Configuration
POSTGRES_DB=oddsyra
POSTGRES_USER=oddsyra_app
POSTGRES_PASSWORD=oddsyra_dev_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgresql://oddsyra_app:oddsyra_dev_pass@127.0.0.1:5432/oddsyra
# Optional Postgres read replica for live lists / admin GETs. Omit to use primary.
# DATABASE_READ_URL=postgresql://oddsyra_app:oddsyra_dev_pass@127.0.0.1:5433/oddsyra

# Optional hashed-asset CDN. index.html stays on origin with no-store.
# VITE_CDN_ASSET_ORIGIN=https://cdn.oddsyra.com
# CDN_ASSET_ORIGIN=https://cdn.oddsyra.com
VITE_SITE_URL=https://oddsyra.com

# India DLT SMS — stays skipped until SMTP fallback (Brevo) is configured so email failover can be monitored.
# SMS_DLT_API_URL=
# SMS_DLT_API_KEY=
# SMS_DLT_SENDER_ID=
# SMS_DLT_ENTITY_ID=
# SMS_DLT_TEMPLATE_ID=

# Web push dispatcher — same gate as SMS (email failover monitored first).
# WEB_PUSH_DISPATCH_URL=
# WEB_PUSH_VAPID_PUBLIC=

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Auth & Security
JWT_SECRET=oddsyra_jwt_secret_dev_key_2026
CORS_ORIGIN=http://localhost:5173
# Optional. When set, GET /metrics requires Authorization: Bearer <token>.
# METRICS_TOKEN=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=oddsyra_wh_secret_2026
VITE_RAZORPAY_KEY_ID=rzp_test_your_key

# Explicit demo wallet. Never implied by Vite DEV. Production build must be 0:
#   VITE_DEMO_MODE=0 npm run build
# Set to 1 only for local client-wallet demos.
VITE_DEMO_MODE=0

# Odds freshness (centralized — do not hardcode in engines)
# Default live threshold ≈ max(15s, LIVE_SCORES_POLL_MS * 8 + cache TTL)
# LIVE_SCORES_POLL_MS=2000
# AGGREGATOR_CACHE_TTL_MS=1000
# ODDS_LIVE_STALE_MS=16000
# ODDS_PREMATCH_STALE_MS=300000
# ODDS_STALE_MS_CRICBUZZ=
# ODDS_STALE_MS_CREX=
# ODDS_STALE_MS_FANCODE=
# ODDS_STALE_MS_ESPN=
# ODDS_STALE_MS_TENCRIC=

# =============================================================================
# EMAIL — OddsYra mailboxes (fill passwords from Zoho App Passwords / Resend)
#   no-reply@oddsyra.com  → transactional / security (send)
#   promos@oddsyra.com    → marketing / targeted campaigns (send)
#   support@oddsyra.com   → player support inbox + Reply-To (receive)
#   alerts@oddsyra.com    → ops / SLA / new-ticket alerts (receive)
# DNS: SPF + DKIM + DMARC on oddsyra.com (Zoho Admin → Domains)
# =============================================================================

# Primary SMTP (send as no-reply@)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@oddsyra.com
SMTP_PASSWORD=
SMTP_FROM="OddsYra <no-reply@oddsyra.com>"
SMTP_PRIMARY_DAILY_LIMIT=0

# Promotions SMTP (send as promos@ — required for Targeted campaigns)
SMTP_PROMOS_HOST=smtp.zoho.in
SMTP_PROMOS_PORT=465
SMTP_PROMOS_SECURE=true
SMTP_PROMOS_USER=promos@oddsyra.com
SMTP_PROMOS_PASSWORD=
PROMOS_FROM="OddsYra <promos@oddsyra.com>"
PROMOS_REPLY_TO=promos@oddsyra.com

# Support + alerts (receive; no password needed unless you also send from them)
SUPPORT_FROM="OddsYra Support <support@oddsyra.com>"
SUPPORT_REPLY_TO=support@oddsyra.com
SUPPORT_INBOX_EMAIL=support@oddsyra.com
ALERTS_FROM="OddsYra Alerts <alerts@oddsyra.com>"
SUPPORT_ALERT_EMAIL=alerts@oddsyra.com
# Deposit capture ops inbox (TO)
PAYMENTS_ALERT_EMAIL=payments@oddsyra.com
# Escalate (CC) when deposit >= this INR
PAYMENTS_DEPOSIT_HIGH_INR=10000
PAYMENTS_ESCALATE_CC=alerts@oddsyra.com
# Buffer deposits below this INR into an hourly digest (0 = always instant)
PAYMENTS_DEPOSIT_DIGEST_BELOW_INR=500
PAYMENTS_DEPOSIT_DIGEST_INTERVAL_MS=3600000

# Optional Brevo fallback when primary quota/rate-limit is hit
SMTP_FALLBACK_HOST=smtp-relay.brevo.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_SECURE=false
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASSWORD=

# User referral program (free bets via wallets.freebet_balance)
REFERRAL_PROGRAM_ENABLED=true
REFERRAL_REFERRED_FREEBET=500
REFERRAL_REFERRER_FREEBET=500
REFERRAL_MIN_DEPOSIT=1
REFERRAL_REQUIRE_KYC=false
REFERRAL_REQUIRE_RISK_CLEARANCE=true
REFERRAL_MAX_PER_USER=0

# KYC reminder emails (reuse SMTP/Zoho above — no second mail provider)
KYC_REMINDER_COOLDOWN_HOURS=24
KYC_REMINDER_MAX_ATTEMPTS=5
KYC_REMINDER_ADMIN_RATE_LIMIT=30

# Application URLs
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Google OAuth (player sign-in). Redirect URI must match Google Cloud console:
#   http://localhost:5173/_oauth/google
#   https://oddsyra.com/_oauth/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/_oauth/google

# Admin bootstrap (never enable in production — ignored when NODE_ENV=production)
ADMIN_DEV_LOGIN=0
# Local TOTP requirement. Production always requires admin TOTP after password.
ADMIN_MFA_REQUIRED=0
# Optional 32+ char key for encrypting TOTP secrets. Falls back to JWT_SECRET.
# TOTP_ENCRYPTION_KEY=
# Comma-separated emails allowed to open /admin in production (in addition to users with role ADMIN)
# Comma-separated operator emails allowed to open Admin (server ADMIN_EMAILS; optional client mirror)
# VITE_ADMIN_EMAILS=ops@oddsyra.com,owner@oddsyra.com
ADMIN_EMAILS=admin@oddsyra.com,wevexqora@gmail.com

# OddsEngine mode: v3 | shadow | v4 | auto
# Prefer Admin → Trading → Odds engine toggle in prod (runtime, exclusive V3/V4/Shadow).
# ODDS_ENGINE=shadow
