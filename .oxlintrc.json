{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useLiveFieldState",
          "useMatchDetail",
          "buildFieldStateFromApi",
          "useLiveMatches",
          "useLiveSportsMeta",
          "useLiveSports",
          "useBetSlip",
          "useTheme",
          "useAuth",
          "useCasino"
        ]
      }
    ]
  }
}