# =============================================================================
# ODDSYRA SPORTSBOOK — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Hostinger VPS KVM Deployment Template
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO GIT
# =============================================================================

# Node Environment & Server Setup
NODE_ENV=production
PORT=5001
APP_NAME=OddsYra Sportsbook
APP_URL=https://oddsyra.com
FRONTEND_URL=https://oddsyra.com
CORS_ORIGIN=https://oddsyra.com
API_URL=https://oddsyra.com

# PostgreSQL Production Database (Isolated Private Docker Network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=oddsyra
POSTGRES_USER=oddsyra_app
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD
DATABASE_URL=postgresql://oddsyra_app:CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD@postgres:5432/oddsyra?sslmode=disable&pool_max=20

# Redis Production Cache (Isolated Private Docker Network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_PRODUCTION_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_PRODUCTION_REDIS_PASSWORD@redis:6379

# Internal readiness probe token (optional; localhost bypasses)
READINESS_TOKEN=CHANGE_ME_READINESS_PROBE_TOKEN

# Authentication & Security
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET_32_BYTES_MINIMUM
SESSION_SECRET=CHANGE_ME_PRODUCTION_SESSION_SECRET
ADMIN_SECRET_KEY=CHANGE_ME_PRODUCTION_ADMIN_SECRET

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_PRODUCTION_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION_WEBHOOK_SECRET

# Sports Feed Provider
SPORTS_PROVIDER_API_KEY=CHANGE_ME_PRODUCTION_SPORTS_KEY
SPORTS_PROVIDER_URL=https://api.sportradar.us

# WebSocket & Realtime Server
WS_PORT=5001
WS_HEARTBEAT_INTERVAL=30000

# Security, CORS & Rate Limiting
CORS_ALLOWED_ORIGINS=https://oddsyra.com,https://www.oddsyra.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true

# SMTP — Resend primary, Brevo fallback
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=CHANGE_ME_RESEND_API_KEY
SMTP_FROM="OddsYra <no-reply@oddsyra.com>"
SMTP_PRIMARY_DAILY_LIMIT=0
SMTP_FALLBACK_HOST=smtp-relay.brevo.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_SECURE=false
SMTP_FALLBACK_USER=CHANGE_ME_BREVO_LOGIN
SMTP_FALLBACK_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
